# Database (Neon PostgreSQL recommended for Vercel)
# Use the pooled connection string for serverless:
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Auth — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-openssl-rand-base64-32"

# Public app URL (no trailing slash)
# Local:  http://localhost:3000
# Prod:   https://gorepyo.com
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# HIPAA PHI encryption key — must be exactly 32 bytes, base64 encoded
# Generate with: openssl rand -base64 32
PHI_ENCRYPTION_KEY="replace-with-openssl-rand-base64-32"

# Salesforce CRM (optional — demo mode works without these)
# Create a Connected App in Salesforce with OAuth callback:
#   {AUTH_URL}/api/company/salesforce/callback
SALESFORCE_CLIENT_ID=""
SALESFORCE_CLIENT_SECRET=""
# Set to true to use demo device lookups when Salesforce is not connected
SALESFORCE_MOCK="true"

# Email confirmation for invite signups (optional — dev logs links to console)
RESEND_API_KEY=""
EMAIL_FROM="Repyo <noreply@yourdomain.com>"

# Vercel scheduled coverage-alert processing (set the same secret in Vercel)
CRON_SECRET="replace-with-a-random-secret-of-at-least-16-characters"
