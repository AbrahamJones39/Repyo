generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  COMPANY_ADMIN
  REP
  PROVIDER
}

enum RequestUrgency {
  ASAP
  SAME_DAY
  SCHEDULED
}

enum RequestType {
  CASE
  CHECK
}

enum RequestStatus {
  REQUESTING
  ACCEPTED
  EN_ROUTE
  ARRIVED
  COMPLETED
  CANCELLED
  DECLINED
}

enum RepStatus {
  AVAILABLE
  BUSY
  OFF_DUTY
  VACATION
}

enum CredentialStatus {
  ACTIVE
  PENDING
  EXPIRED
  REVOKED
}

enum UserAccountState {
  REGISTERED
  VERIFIED
  SUSPENDED
  DISABLED
  REVOKED
}

enum RecordLifecycle {
  ACTIVE
  ARCHIVED
  LEGAL_HOLD
  PENDING_DESTRUCTION
  DESTROYED
}

enum RoutingEventType {
  REQUEST_CREATED
  ROUTING_SELECTED_COMPANY
  ADMIN_MATCHED
  REP_NOTIFIED
  REP_AUTO_ASSIGNED
  REP_OPENED_REQUEST
  REP_ACKNOWLEDGED
  REP_FORWARDED
  REP_DECLINED
  ADMIN_REASSIGNED
  REP_ACCEPTED
  PHI_ACCESSED
  REQUEST_REROUTED
  ESCALATED_TO_MANAGER
  KILL_SWITCH_APPLIED
}

enum PhiAccessType {
  NOTIFICATION_SENT
  NOTIFICATION_DELIVERED
  REQUEST_OPENED
  PHI_DISPLAYED
  CRM_LOOKUP
}

enum PermissionChangeType {
  ROLE_CHANGED
  ADMIN_PERMISSIONS_CHANGED
  ORG_ADMIN_GRANTED
  ORG_ADMIN_REVOKED
  USER_VERIFICATION_DECISION
  CALENDAR_VISIBILITY_CHANGED
  TEAM_MEMBERSHIP_CHANGED
  ORG_UNIT_CHANGED
  MANAGER_CHANGED
  TERRITORY_CHANGED
  DELEGATION_CHANGED
  ACCOUNT_STATE_CHANGED
  CREDENTIAL_STATUS_CHANGED
  MFA_ENABLED
  MFA_DISABLED
  SESSION_REVOKED
}

enum UserVerificationMethod {
  MANUAL_ADMIN_APPROVAL
  APPROVED_EMAIL_DOMAIN
  EMAIL_DOMAIN_PLUS_ADMIN_APPROVAL
  INVITATION_ONLY
  PREAPPROVED_ROSTER
  SSO
  SCIM
  API_DIRECTORY_VERIFICATION
}

enum VerificationDecision {
  AUTO_APPROVED
  PENDING_REVIEW
  REJECTED
  REQUIRES_INVITATION
}

enum AuthorizationSource {
  SIGNUP_VERIFICATION
  ADMIN_GRANT
  SSO_PROVISIONING
  SCIM_PROVISIONING
  API_DIRECTORY
  ROSTER_IMPORT
  INVITATION
  SUPER_ADMIN
  SYSTEM
}

enum KillSwitchScope {
  GLOBAL
  USER
  ORGANIZATION
  COMPANY
  REQUEST
  INTEGRATION
}

enum TeamCalendarVisibility {
  SHARED_WITH_TEAM
  HIDDEN_FROM_TEAM_PEERS
}

enum CalendarVisibilitySource {
  TEAM_DEFAULT
  MANAGER_OVERRIDE
  REP_PREFERENCE
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum InvitationChannel {
  EMAIL
  LINK
  QR
}

enum InvitationType {
  PEER
  ADMIN
  ORG_ADMIN
}

model User {
  id               String           @id @default(uuid())
  role             Role
  email            String           @unique
  passwordHash     String
  name             String
  phone            String?
  companyId        String?
  managerId        String?
  orgUnitId        String?
  zipCodeStart     String?
  zipCodeEnd       String?
  delegatedRepId   String?
  delegationActive Boolean          @default(false)
  accountState     UserAccountState @default(REGISTERED)
  emailVerifiedAt  DateTime?
  verifiedAt       DateTime?
  sessionVersion   Int              @default(0)
  mfaEnabled       Boolean          @default(false)
  mfaSecretEnc     String?
  adminPermissions String[]         @default([])
  disabledAt       DateTime?
  disabledById     String?
  disableReason    String?
  lastSessionRevokedAt DateTime?
  company          Company?         @relation(fields: [companyId], references: [id])
  manager          User?            @relation("ReportingLine", fields: [managerId], references: [id])
  directReports    User[]           @relation("ReportingLine")
  homeOrgUnit      OrgUnit?         @relation("UserHomeOrgUnit", fields: [orgUnitId], references: [id])
  orgAssignments   OrgUnitAssignment[]
  delegatedRep     User?            @relation("AdminDelegation", fields: [delegatedRepId], references: [id])
  delegatingAdmins User[]           @relation("AdminDelegation")
  repProfile       RepProfile?
  providerInfo     ProviderProfile?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  providerRequests   ServiceRequest[] @relation("ProviderRequests")
  assignedRequests   ServiceRequest[] @relation("AssignedRepRequests")
  originalRepRequests ServiceRequest[] @relation("OriginalRepRequests")
  acknowledgedRequests ServiceRequest[] @relation("AcknowledgedRequests")
  adminRequests      ServiceRequest[] @relation("AdminRequests")
  initiatedRequests  ServiceRequest[] @relation("RepInitiatedRequests")
  favoriteReps     FavoriteRep[]    @relation("ProviderFavorites")
  favoritedBy      FavoriteRep[]    @relation("RepFavorites")
  notifications    Notification[]
  routingEvents    RequestRoutingEvent[] @relation("RoutingActor")
  phiAccessLogs    PhiAccessLog[]
  permissionChangesTarget PermissionChangeLog[] @relation("PermissionTarget")
  permissionChangesBy     PermissionChangeLog[] @relation("PermissionChangedBy")
  killSwitchesActivated   SecurityKillSwitch[]  @relation("KillSwitchActivator")
  agreementAcceptances    AgreementAcceptance[]
  authorizationGrants     AuthorizationGrant[]  @relation("AuthorizationGrantee")
  authorizationGrantsMade AuthorizationGrant[]  @relation("AuthorizationGranter")
  authorizationRevoked    AuthorizationGrant[]  @relation("AuthorizationRevoker")
  verificationEvents      UserVerificationEvent[]
  orgAdminProfilesGranted ProviderProfile[]     @relation("OrgAdminGranter")
  invitationsSent         PlatformInvitation[] @relation("InvitationSender")
  invitationsRevoked      PlatformInvitation[] @relation("InvitationRevoker")
  invitationsAccepted     PlatformInvitation[] @relation("InvitationAccepter")
  invitationsAsManager    PlatformInvitation[] @relation("InvitationDesignatedManager")
  providerSiteMemberships ProviderSiteMembership[]
  repSiteCoverages        RepSiteCoverage[]
  healthcareSitesCreated  HealthcareSite[]         @relation("SiteCreator")
  managedTeams            CompanyTeam[]            @relation("TeamManager")
  teamMemberships         CompanyTeamMember[]
  requestsEscalatedTo     ServiceRequest[]     @relation("EscalatedToManager")
  forwardsSent            RequestForward[]         @relation("ForwardSender")
  forwardsReceived        RequestForward[]         @relation("ForwardRecipient")
  forwardsAsOriginal      RequestForward[]         @relation("ForwardOriginalRep")
}

model Company {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  products  String[]
  manufacturerAliases String[] @default([])
  active    Boolean  @default(true)
  accessEnabled       Boolean @default(true)
  integrationsEnabled Boolean @default(true)
  killSwitchAt        DateTime?
  killSwitchReason    String?
  salesforceInstanceUrl       String?
  salesforceAccessTokenEnc    String?
  salesforceRefreshTokenEnc   String?
  salesforceTokenExpiresAt    DateTime?
  salesforceConnectedAt       DateTime?
  salesforceDeviceObject      String?  @default("Implant_Device__c")
  salesforceCaseObject        String?  @default("Case")
  userVerificationMethod      UserVerificationMethod @default(MANUAL_ADMIN_APPROVAL)
  approvedEmailDomains        String[] @default([])
  ssoEnabled                  Boolean  @default(false)
  scimEnabled                 Boolean  @default(false)
  forwardEnabled              Boolean  @default(true)
  forwardTeamMembersOnly      Boolean  @default(false)
  forwardAllowManagers        Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  serviceRequests ServiceRequest[]
  facilities      Facility[]
  authorizationGrants AuthorizationGrant[]
  verificationEvents  UserVerificationEvent[]
  rosterEntries       PreapprovedRosterEntry[]
  invitations         PlatformInvitation[]
  teams               CompanyTeam[]
  orgUnits            OrgUnit[]
}

model Facility {
  id        String   @id @default(uuid())
  companyId String?
  name      String
  address   String
  phone     String?
  lat       Float?
  lng       Float?
  state     String?
  county    String?
  zipCode   String?
  createdAt DateTime @default(now())

  company   Company? @relation(fields: [companyId], references: [id])
  territories Territory[]
}

enum ProviderOrgComplianceMode {
  STANDARD
  PHI_ENABLED
}

enum ProviderOrgStatus {
  PENDING
  VERIFIED
  ACTIVATED
}

enum ProviderAccountStatus {
  LIMITED
  PENDING_APPROVAL
  PENDING_AGREEMENTS
  ACTIVE
}

enum HealthcareSiteType {
  HOSPITAL
  CLINIC
  SURGERY_CENTER
  OTHER
}

enum HealthcareSiteStatus {
  ACTIVE
  PENDING_REVIEW
  MERGED
}

model ProviderOrganization {
  id             String                   @id @default(uuid())
  name           String
  slug           String                   @unique
  complianceMode ProviderOrgComplianceMode @default(STANDARD)
  status         ProviderOrgStatus        @default(PENDING)
  contactEmail   String?
  baaExecutedAt  DateTime?
  orgAgreementAt DateTime?
  phiEnabledAt   DateTime?
  accessEnabled  Boolean                  @default(true)
  killSwitchAt   DateTime?
  killSwitchReason String?
  verifiedAt     DateTime?
  userVerificationMethod UserVerificationMethod @default(MANUAL_ADMIN_APPROVAL)
  approvedEmailDomains   String[]               @default([])
  ssoEnabled             Boolean                @default(false)
  scimEnabled            Boolean                @default(false)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  facilities     ProviderOrgFacility[]
  providers      ProviderProfile[]
  accessRequests OrganizationAccessRequest[]
  authorizationGrants AuthorizationGrant[]
  verificationEvents  UserVerificationEvent[]
  rosterEntries       PreapprovedRosterEntry[]
  invitations         PlatformInvitation[]
  siteLinks           OrganizationSiteLink[]
  providerSiteMemberships ProviderSiteMembership[]
}

model HealthcareSite {
  id          String               @id @default(uuid())
  slug        String               @unique
  name        String
  address     String
  city        String
  state       String
  zipCode     String
  phone       String?
  lat         Float?
  lng         Float?
  siteType    HealthcareSiteType   @default(HOSPITAL)
  status      HealthcareSiteStatus @default(ACTIVE)
  createdById String?
  verifiedAt  DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  createdBy           User?                    @relation("SiteCreator", fields: [createdById], references: [id])
  organizationLinks   OrganizationSiteLink[]
  providerMemberships ProviderSiteMembership[]
  repCoverages        RepSiteCoverage[]
  orgFacilities       ProviderOrgFacility[]
  serviceRequests     ServiceRequest[]
  invitations         PlatformInvitation[]

  @@index([name])
  @@index([state, city])
  @@index([zipCode])
  @@index([status])
}

model OrganizationSiteLink {
  id             String   @id @default(uuid())
  organizationId String
  siteId         String
  isPrimary      Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization ProviderOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site         HealthcareSite       @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([organizationId, siteId])
}

model ProviderSiteMembership {
  id             String   @id @default(uuid())
  userId         String
  siteId         String
  organizationId String?
  isPrimary      Boolean  @default(false)
  jobTitle       String?
  department     String?
  createdAt      DateTime @default(now())

  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  site         HealthcareSite        @relation(fields: [siteId], references: [id], onDelete: Cascade)
  organization ProviderOrganization? @relation(fields: [organizationId], references: [id])

  @@unique([userId, siteId])
  @@index([siteId])
}

model RepSiteCoverage {
  id        String   @id @default(uuid())
  repUserId String
  siteId    String
  createdAt DateTime @default(now())

  rep  User           @relation(fields: [repUserId], references: [id], onDelete: Cascade)
  site HealthcareSite @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([repUserId, siteId])
  @@index([siteId])
}

model ProviderOrgFacility {
  id             String   @id @default(uuid())
  organizationId String
  siteId         String?
  name           String
  address        String
  phone          String?
  zipCode        String?
  department     String?
  createdAt      DateTime @default(now())

  organization ProviderOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site         HealthcareSite?      @relation(fields: [siteId], references: [id])
  providers    ProviderProfile[]

  @@index([siteId])
}

model OrganizationAccessRequest {
  id               String   @id @default(uuid())
  organizationId   String?
  requestedOrgName String
  userId           String?
  email            String
  name             String
  facilityName     String?
  department       String?
  zipCode          String?
  status           String   @default("PENDING")
  createdAt        DateTime @default(now())

  organization ProviderOrganization? @relation(fields: [organizationId], references: [id])

  @@index([requestedOrgName])
  @@index([organizationId])
}

model ProviderProfile {
  userId               String   @id
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId       String?
  facilityId           String?
  accountStatus        ProviderAccountStatus @default(LIMITED)
  jobTitle             String?
  isOrgAdministrator   Boolean               @default(false)
  orgAdminGrantedById  String?
  orgAdminGrantedAt    DateTime?
  verificationDecision VerificationDecision?
  verificationSource   AuthorizationSource?
  identityVerifiedAt   DateTime?
  workEmail            String?
  workEmailVerified    Boolean  @default(false)
  termsAcceptedAt      DateTime?
  userAgreementAt      DateTime?
  onboardingComplete   Boolean  @default(false)
  onboardingStep       Int      @default(0)
  facilityName         String?
  facilityAddress      String?
  facilityPhone        String?
  facilityContactName  String?
  facilityContactPhone String?
  department           String?
  defaultPhysician     String?
  zipCode              String?
  requesterPhone       String?
  requesterFax         String?

  organization ProviderOrganization? @relation(fields: [organizationId], references: [id])
  orgFacility  ProviderOrgFacility?  @relation(fields: [facilityId], references: [id])
  orgAdminGrantedBy User?            @relation("OrgAdminGranter", fields: [orgAdminGrantedById], references: [id])
}

enum AvailabilityBlockType {
  VACATION
  OFF
}

model RepProfile {
  userId            String           @id
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  status            RepStatus        @default(OFF_DUTY)
  travelRadiusMiles Float            @default(50)
  maxTravelDistance Float            @default(100)
  lat               Float?
  lng               Float?
  credentialStatus  CredentialStatus @default(PENDING)
  symplrMerged      Boolean          @default(false)
  vendormateMerged  Boolean          @default(false)
  onCallEnabled     Boolean          @default(false)
  products          String[]
  companies         String[]
  updatedAt         DateTime         @updatedAt

  territories         Territory[]
  scheduleRules       RepScheduleRule[]
  availabilityBlocks  RepAvailabilityBlock[]
}

model RepScheduleRule {
  id           String @id @default(uuid())
  repProfileId String
  dayOfWeek    Int
  startTime    String
  endTime      String

  repProfile RepProfile @relation(fields: [repProfileId], references: [userId], onDelete: Cascade)

  @@index([repProfileId])
}

model RepAvailabilityBlock {
  id           String                @id @default(uuid())
  repProfileId String
  type         AvailabilityBlockType @default(VACATION)
  startAt      DateTime
  endAt        DateTime
  note         String?

  repProfile RepProfile @relation(fields: [repProfileId], references: [userId], onDelete: Cascade)

  @@index([repProfileId, startAt, endAt])
}

model Territory {
  id           String  @id @default(uuid())
  repProfileId String
  state        String?
  county       String?
  zipCode      String?
  facilityId   String?

  repProfile RepProfile @relation(fields: [repProfileId], references: [userId], onDelete: Cascade)
  facility   Facility?  @relation(fields: [facilityId], references: [id])

  @@index([repProfileId])
  @@index([state, county, zipCode])
}

model OrgUnit {
  id        String   @id @default(uuid())
  companyId String
  parentId  String?
  name      String
  /// Free-form label (Company, Division, Region, Area, Territory, Team, etc.).
  /// Not an enum so manufacturers can name their own ladder.
  typeLabel String   @default("Unit")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company     Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent      OrgUnit?             @relation("OrgUnitHierarchy", fields: [parentId], references: [id])
  children    OrgUnit[]            @relation("OrgUnitHierarchy")
  members     User[]               @relation("UserHomeOrgUnit")
  assignments OrgUnitAssignment[]
  teams       CompanyTeam[]
  invitations PlatformInvitation[]

  @@index([companyId, parentId])
}

model OrgUnitAssignment {
  id          String   @id @default(uuid())
  orgUnitId   String
  userId      String
  /// Operational permissions for this unit and its descendants. Never grants PHI.
  permissions String[] @default([])
  createdAt   DateTime @default(now())

  orgUnit OrgUnit @relation(fields: [orgUnitId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgUnitId, userId])
  @@index([userId])
}

model CompanyTeam {
  id                        String                 @id @default(uuid())
  companyId                 String
  orgUnitId                 String?
  name                      String
  managerUserId             String
  defaultCalendarVisibility TeamCalendarVisibility @default(SHARED_WITH_TEAM)
  requireManualVerification Boolean                @default(false)
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt

  company     Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  orgUnit     OrgUnit?            @relation(fields: [orgUnitId], references: [id], onDelete: SetNull)
  manager     User                @relation("TeamManager", fields: [managerUserId], references: [id])
  members     CompanyTeamMember[]
  assignments ServiceRequest[]
  invitations PlatformInvitation[]
  forwards    RequestForward[]

  @@index([companyId])
  @@index([managerUserId])
}

model CompanyTeamMember {
  id       String   @id @default(uuid())
  teamId   String
  userId   String
  joinedAt DateTime @default(now())

  team CompanyTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
}

model ServiceRequest {
  id                   String         @id @default(uuid())
  providerId           String?
  initiatedByRepId     String?
  companyId            String
  assignedAdminId      String?
  assignedRepId        String?
  assignedAt           DateTime?
  escalatedAt          DateTime?
  escalatedToId        String?
  missedByRepId        String?
  healthcareSiteId     String?
  teamId               String?
  teamCalendarVisibility TeamCalendarVisibility @default(SHARED_WITH_TEAM)
  calendarVisibilitySetById String?
  calendarVisibilitySetAt   DateTime?
  calendarVisibilitySource  CalendarVisibilitySource @default(TEAM_DEFAULT)
  facilityName         String
  facilityAddr         String
  facilityPhone        String?
  facilityContactName  String?
  facilityContactPhone String?
  facilityLat          Float?
  facilityLng          Float?
  facilityZipCode      String?
  department           String?
  requesterName        String?
  requesterPhone       String?
  requesterEmail       String?
  requesterFax         String?
  physicianName        String?
  patientNameEnc       String?
  patientDOBEnc        String?
  patientRoomEnc       String?
  deviceManufacturer   String?
  deviceNameEnc        String?
  deviceSerialEnc      String?
  salesforceRecordId   String?
  salesforceCaseId     String?
  crmLookupStatus      String?
  procedureType        String?
  requestType          RequestType    @default(CASE)
  product              String?
  urgency              RequestUrgency
  scheduledAt          DateTime
  status               RequestStatus  @default(REQUESTING)
  recordLifecycle      RecordLifecycle @default(ACTIVE)
  accessEnabled        Boolean        @default(true)
  killSwitchAt         DateTime?
  killSwitchReason     String?
  notes                String?
  repLat               Float?
  repLng               Float?
  etaMinutes           Int?
  originalRepId        String?
  acknowledgedAt       DateTime?
  acknowledgedById     String?
  alertActive          Boolean        @default(false)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  provider       User?    @relation("ProviderRequests", fields: [providerId], references: [id])
  initiatedByRep User?    @relation("RepInitiatedRequests", fields: [initiatedByRepId], references: [id])
  assignedAdmin  User?    @relation("AdminRequests", fields: [assignedAdminId], references: [id])
  company        Company  @relation(fields: [companyId], references: [id])
  assignedRep    User?    @relation("AssignedRepRequests", fields: [assignedRepId], references: [id])
  escalatedTo    User?    @relation("EscalatedToManager", fields: [escalatedToId], references: [id])
  originalRep    User?    @relation("OriginalRepRequests", fields: [originalRepId], references: [id])
  acknowledgedBy User?    @relation("AcknowledgedRequests", fields: [acknowledgedById], references: [id])
  healthcareSite HealthcareSite? @relation(fields: [healthcareSiteId], references: [id])
  team           CompanyTeam?    @relation(fields: [teamId], references: [id])
  statusLogs     RequestStatusLog[]
  routingEvents  RequestRoutingEvent[]
  phiAccessLogs  PhiAccessLog[]
  forwards       RequestForward[]

  @@index([providerId])
  @@index([initiatedByRepId])
  @@index([assignedAdminId])
  @@index([assignedRepId])
  @@index([escalatedToId])
  @@index([status])
  @@index([companyId])
}

model RequestForward {
  id                    String   @id @default(uuid())
  requestId             String
  originalRepId         String
  forwardedById         String
  forwardedToId         String
  forwardReason         String?
  forwardTimestamp      DateTime @default(now())
  authorizationCheck    Json
  newRepAcknowledgedAt  DateTime?
  newRepAcceptedAt      DateTime?
  targetTeamId          String?

  request      ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  originalRep  User           @relation("ForwardOriginalRep", fields: [originalRepId], references: [id])
  forwardedBy  User           @relation("ForwardSender", fields: [forwardedById], references: [id])
  forwardedTo  User           @relation("ForwardRecipient", fields: [forwardedToId], references: [id])
  targetTeam   CompanyTeam?   @relation(fields: [targetTeamId], references: [id], onDelete: SetNull)

  @@index([requestId, forwardTimestamp])
  @@index([originalRepId])
  @@index([forwardedToId])
  @@index([forwardedById])
}

model RequestStatusLog {
  id        String        @id @default(uuid())
  requestId String
  status    RequestStatus
  note      String?
  lat       Float?
  lng       Float?
  createdAt DateTime      @default(now())

  request ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

model FavoriteRep {
  id         String   @id @default(uuid())
  providerId String
  repId      String
  createdAt  DateTime @default(now())

  provider User @relation("ProviderFavorites", fields: [providerId], references: [id], onDelete: Cascade)
  rep      User @relation("RepFavorites", fields: [repId], references: [id], onDelete: Cascade)

  @@unique([providerId, repId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  body      String
  type      String
  data      Json?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

model RequestRoutingEvent {
  id             String           @id @default(uuid())
  requestId      String
  eventType      RoutingEventType
  actorId        String?
  actorRole      Role?
  organizationId String?
  companyId      String?
  targetUserId   String?
  metadata       Json?
  createdAt      DateTime         @default(now())

  request ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actor   User?          @relation("RoutingActor", fields: [actorId], references: [id])

  @@index([requestId, createdAt])
}

model PhiAccessLog {
  id             String        @id @default(uuid())
  requestId      String?
  userId         String
  userRole       Role
  organizationId String?
  companyId      String?
  accessType     PhiAccessType
  metadata       Json?
  createdAt      DateTime      @default(now())

  request ServiceRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user    User             @relation(fields: [userId], references: [id])

  @@index([requestId, createdAt])
  @@index([userId, createdAt])
}

model PermissionChangeLog {
  id           String               @id @default(uuid())
  targetUserId String
  changedById  String
  changeType   PermissionChangeType
  beforeState  Json
  afterState   Json
  reason       String?
  createdAt    DateTime             @default(now())

  targetUser User @relation("PermissionTarget", fields: [targetUserId], references: [id])
  changedBy  User @relation("PermissionChangedBy", fields: [changedById], references: [id])

  @@index([targetUserId, createdAt])
}

model SecurityKillSwitch {
  id              String          @id @default(uuid())
  scope           KillSwitchScope
  scopeId         String?
  active          Boolean         @default(true)
  reason          String
  activatedById   String
  deactivatedAt   DateTime?
  deactivatedById String?
  createdAt       DateTime        @default(now())

  activatedBy User @relation("KillSwitchActivator", fields: [activatedById], references: [id])

  @@index([scope, scopeId, active])
}

model LegalDocument {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  version     String
  roleScopes  Role[]
  summary     String?
  content     String   @db.Text
  effectiveAt DateTime @default(now())
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  acceptances AgreementAcceptance[]
}

model AgreementAcceptance {
  id               String   @id @default(uuid())
  userId           String
  documentId       String
  documentSlug     String
  documentVersion  String
  documentTitle    String
  legalName        String
  role             Role
  organizationId   String?
  organizationName String?
  facilityName     String?
  signatureText    String
  ipAddress        String?
  userAgent        String?
  metadata         Json?
  acceptedAt       DateTime @default(now())

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  document LegalDocument @relation(fields: [documentId], references: [id])

  @@index([userId, acceptedAt])
  @@index([documentId])
}

model AuthorizationGrant {
  id             String              @id @default(uuid())
  userId         String
  grantedById    String?
  organizationId String?
  companyId      String?
  facilityId     String?
  grantType      String
  permissions    String[]            @default([])
  source         AuthorizationSource
  ownerLabel     String?
  metadata       Json?
  grantedAt      DateTime            @default(now())
  revokedAt      DateTime?
  revokedById    String?

  user         User                  @relation("AuthorizationGrantee", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy    User?                 @relation("AuthorizationGranter", fields: [grantedById], references: [id])
  revokedBy    User?                 @relation("AuthorizationRevoker", fields: [revokedById], references: [id])
  organization ProviderOrganization? @relation(fields: [organizationId], references: [id])
  company      Company?              @relation(fields: [companyId], references: [id])

  @@index([userId, grantedAt])
  @@index([organizationId])
  @@index([companyId])
}

model UserVerificationEvent {
  id                 String                 @id @default(uuid())
  userId             String
  email              String
  organizationId     String?
  companyId          String?
  verificationMethod UserVerificationMethod
  decision           VerificationDecision
  reason             String?
  source             AuthorizationSource    @default(SYSTEM)
  metadata           Json?
  createdAt          DateTime               @default(now())

  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization ProviderOrganization? @relation(fields: [organizationId], references: [id])
  company      Company?              @relation(fields: [companyId], references: [id])

  @@index([userId, createdAt])
  @@index([organizationId])
  @@index([companyId])
}

model PreapprovedRosterEntry {
  id             String              @id @default(uuid())
  organizationId String?
  companyId      String?
  email          String
  name           String?
  jobTitle       String?
  facilityId     String?
  active         Boolean             @default(true)
  importedById   String?
  source         AuthorizationSource @default(ROSTER_IMPORT)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization ProviderOrganization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company      Company?              @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([email, organizationId])
  @@index([email, companyId])
}

model PlatformInvitation {
  id                 String             @id @default(uuid())
  token              String             @unique
  invitedById        String
  inviteeEmail       String?
  targetRole         Role
  invitationType     InvitationType     @default(PEER)
  channel            InvitationChannel    @default(LINK)
  status             InvitationStatus     @default(PENDING)
  organizationId     String?
  companyId          String?
  teamId             String?
  orgUnitId          String?
  managerId          String?
  healthcareSiteId   String?
  facilityId         String?
  territoryContext   Json?
  preconfig          Json?
  expiresAt          DateTime
  acceptedAt         DateTime?
  acceptedByUserId   String?
  revokedAt          DateTime?
  revokedById        String?
  createdAt          DateTime           @default(now())

  invitedBy      User                  @relation("InvitationSender", fields: [invitedById], references: [id])
  revokedBy      User?                 @relation("InvitationRevoker", fields: [revokedById], references: [id])
  acceptedByUser User?                 @relation("InvitationAccepter", fields: [acceptedByUserId], references: [id])
  organization   ProviderOrganization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company        Company?              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  team           CompanyTeam?          @relation(fields: [teamId], references: [id], onDelete: SetNull)
  orgUnit        OrgUnit?              @relation(fields: [orgUnitId], references: [id], onDelete: SetNull)
  designatedManager User?              @relation("InvitationDesignatedManager", fields: [managerId], references: [id], onDelete: SetNull)
  healthcareSite HealthcareSite?       @relation(fields: [healthcareSiteId], references: [id], onDelete: SetNull)

  @@index([inviteeEmail, status])
  @@index([invitedById, createdAt])
  @@index([organizationId, status])
  @@index([companyId, status])
  @@index([expiresAt])
}

model PendingSignup {
  id             String   @id @default(uuid())
  confirmToken   String   @unique
  email          String
  passwordHash   String
  payload        Json
  invitationId   String?
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  @@index([email])
  @@index([expiresAt])
}
